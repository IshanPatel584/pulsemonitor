# Leave VITE_API_URL empty in development: requests go to /api on the Vite dev
# server, which proxies them to the backend (see vite.config.js).
#
# Set it only if the frontend must call the backend directly, e.g.
#   VITE_API_URL=http://localhost:5000
# That requires the backend to enable CORS with credentials for this origin.
VITE_API_URL=

# Dev-proxy target used by `npm run dev` (defaults to http://localhost:5000).
# VITE_API_PROXY=http://localhost:5000
