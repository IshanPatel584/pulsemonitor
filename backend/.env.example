# Copy to backend/.env and fill in. Never commit .env (it is git-ignored).

# REQUIRED. Secret used to sign session tokens (HS256). At least 32 characters.
# The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional, but required for custom monitor headers (API keys, bearer tokens).
# 32 random bytes (base64 or hex) used to encrypt header values in the database.
# Without it, monitors work but can't be given headers. Keep it secret and stable:
# changing it makes saved header values unreadable (they then need re-entering).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MONITOR_CREDENTIALS_KEY=

# Set to "production" in production: session cookies are then always Secure (HTTPS only).
NODE_ENV=development

# Optional. Session lifetime in seconds for both the token and the cookie (default 86400 = 1 day).
# JWT_TTL_SECONDS=86400

# Optional. strict | lax | none (default lax). "none" is only for cross-site frontends and forces Secure.
# COOKIE_SAME_SITE=lax

# Optional. "true" marks cookies Secure outside production (e.g. a local HTTPS setup).
# COOKIE_SECURE=false

# Optional monitoring settings.
# MONITOR_TIMEOUT_MS=10000
# MONITOR_MAX_CONCURRENCY=10
# CHECK_RETENTION_DAYS=30

# Tests only: MongoDB server for the throwaway pulsemonitor_test_* databases.
# TEST_MONGO_URL=mongodb://127.0.0.1:27017
